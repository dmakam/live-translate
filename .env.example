# Optional. Without it, translation uses Chrome's free on-device translator.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# Guardrails for the public proof of concept
MAX_ROOMS=100
ROOM_HOURS=4
ADVANCE_DAYS=14
TRANSLATE_PER_MIN=40
DAILY_TRANSLATIONS=5000

# Optional premium voice (ElevenLabs). Leave empty to use the free voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=Premium Indian voice
ELEVENLABS_MODEL=eleven_flash_v2_5

# Speech recognition: with an ElevenLabs key, Scribe v2 Realtime is used (more accurate than Chrome).
# STT=chrome forces Chrome's free recognition. STT_KEYTERMS = comma-separated words to recognise reliably.
STT=
STT_KEYTERMS=Dharma,samskara,samskaras,karma,Heartfulness,Daaji,Mathura,meditation,Pranahuti,spirituality
